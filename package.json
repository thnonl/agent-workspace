{
  "name": "@thnonline/agent-workspace",
  "version": "1.2.0",
  "type": "module",
  "description": "Cute 3D isometric office that visualises Claude Code sessions and sub-agents in real time.",
  "author": "Nam Thai <namth.onl@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thnonl/agent-workspace.git"
  },
  "homepage": "https://github.com/thnonl/agent-workspace#readme",
  "bugs": {
    "url": "https://github.com/thnonl/agent-workspace/issues"
  },
  "keywords": [
    "claude-code",
    "visualization",
    "three.js",
    "monitor"
  ],
  "bin": {
    "agent-workspace": "server/index.mjs"
  },
  "files": [
    "dist",
    "server",
    "!server/*.test.mjs",
    "!server/vite-plugin.mjs",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node server/compress-dist.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs --no-open",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "prepack": "npm run build",
    "licenses": "node scripts/third-party-licenses.mjs",
    "meow": "node scripts/process-meow.mjs",
    "apk": "node scripts/build-apk.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.1",
    "zustand": "^5.0.15"
  }
}
