<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#1D1B2E</color>
    <color name="card">#2B2740</color>
    <color name="accent">#F2A65A</color>
    <color name="ink">#F4EFE6</color>
    <color name="ink_soft">#B5ADC9</color>
    <color name="error">#FF8A80</color>
    <color name="icon_bg">#2B2640</color>

    <style name="Theme.AgentWorkspace" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">#77708C</item>
        <item name="android:singleLine">true</item>
        <item name="android:backgroundTint">@color/accent</item>
    </style>

    <style name="ActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:backgroundTint">@color/accent</item>
    </style>
</resources>
